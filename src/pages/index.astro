---
import '@scania/tegel-lite/scania-variables.css';
import '@scania/tegel-lite/global.css';
import '@scania/tegel-lite/components.css';

import { getCollection, getEntry } from 'astro:content';

import App from '../App';
import '../styles.css';

const page = await getEntry('pages', 'home');
const storyEntries = await getCollection('storyCards');
const pathEntries = await getCollection('pathCards');

if (!page) {
  throw new Error('Missing CMS content entry: src/content/pages/home.json');
}

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;

const data = {
  ...page.data,
  stories: storyEntries.sort(byOrder).map(({ data }) => ({
    title: data.title,
    image: data.image,
    href: data.href,
  })),
  paths: pathEntries.sort(byOrder).map(({ data }) => ({
    title: data.title,
    subtitle: data.subtitle,
    image: data.image,
    href: data.href,
    description: data.description,
  })),
};
---

<!doctype html>
<html lang={data.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={data.seo.description} />
    <title>{data.seo.title}</title>
  </head>
  <body>
    <App client:load content={data} />
  </body>
</html>
