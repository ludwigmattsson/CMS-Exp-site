---
import '@scania/tegel-lite/scania-variables.css';
import '@scania/tegel-lite/global.css';
import '@scania/tegel-lite/components.css';

import { getEntry } from 'astro:content';

import App from '../App';
import '../styles.css';

const page = await getEntry('pages', 'home');

if (!page) {
  throw new Error('Missing CMS content entry: src/content/pages/home.json');
}

const { data } = page;
---

<!doctype html>
<html lang={data.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={data.seo.description} />
    <title>{data.seo.title}</title>
  </head>
  <body>
    <App client:load content={data} />
  </body>
</html>
